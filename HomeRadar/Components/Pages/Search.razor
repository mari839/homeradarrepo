@page "/search"
@rendermode InteractiveServer
@using HomeRadar.Components.SsGe
@using HomeRadar.Services.SsGe
@inject SsGeApiClient ApiClient
@inject ILogger<Search> Logger

<PageTitle>Property Search - HomeRadar</PageTitle>

<h3 class="mb-4">Property Search</h3>

<SearchFilters OnSearch="HandleSearch" IsLoading="_isLoading" />

@if (_error is not null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @_error
        <button type="button" class="btn-close float-end" @onclick="() => _error = null"></button>
    </div>
}

@if (_hasSearched)
{
    <ListingGrid Listings="_listings"
                 TotalCount="_totalCount"
                 CurrentPage="_currentPage"
                 PageSize="16"
                 OnPageChange="HandlePageChange" />
}

@code {
    private List<SsGeListing>? _listings;
    private int _totalCount;
    private int _currentPage = 1;
    private bool _isLoading;
    private bool _hasSearched;
    private string? _error;
    private SsGeSearchRequest? _lastRequest;

    private async Task HandleSearch(SsGeSearchRequest request)
    {
        _lastRequest = request;
        _currentPage = 1;
        request.Page = 1;
        await ExecuteSearch(request);
    }

    private async Task HandlePageChange(int page)
    {
        if (_lastRequest is null) return;
        _currentPage = page;
        _lastRequest.Page = page;
        await ExecuteSearch(_lastRequest);
    }

    private async Task ExecuteSearch(SsGeSearchRequest request)
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var response = await ApiClient.SearchAsync(request);
            _listings = response.Listings;
            // SS.GE totalCount is unreliable (often 0), use actual count as fallback
            _totalCount = response.TotalCount > 0 ? response.TotalCount : response.Listings.Count;
            _hasSearched = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Search failed");
            _error = $"Failed to fetch listings: {ex.Message}";
            _listings = [];
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
