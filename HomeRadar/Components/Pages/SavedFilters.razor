@page "/saved-filters"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using HomeRadar.Components.SsGe
@using HomeRadar.Data
@using HomeRadar.Data.Entities
@using HomeRadar.Services.SsGe
@using HomeRadar.Services.Telegram
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject SsGeApiClient ApiClient
@inject TelegramNotificationService TelegramService
@inject ILogger<SavedFilters> Logger

<PageTitle>Saved Filters - HomeRadar</PageTitle>

<h3 class="mb-4">Saved Filters</h3>

@if (_message is not null)
{
    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

@* ===== Add New Filter Section ===== *@
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Add New Filter</h5>
        <button class="btn btn-sm @(_showNewFilter ? "btn-outline-secondary" : "btn-primary")"
                @onclick="() => _showNewFilter = !_showNewFilter">
            @(_showNewFilter ? "Collapse" : "New Filter")
        </button>
    </div>
    @if (_showNewFilter)
    {
        <div class="card-body">
            <SearchFilters @ref="_newSearchFilters"
                           OnSearch="HandlePreview"
                           IsLoading="_isPreviewLoading"
                           ButtonLabel="Preview" />

            @if (_previewCount.HasValue)
            {
                <div class="alert alert-info">
                    This filter matches <strong>@_previewCount.Value.ToString("N0")</strong> listings.
                </div>
            }

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Filter Name</label>
                    <input type="text" class="form-control" @bind="_newFilterName"
                           placeholder="e.g. 2-room in Saburtalo" />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button class="btn btn-success w-100"
                            @onclick="SaveNewFilter"
                            disabled="@string.IsNullOrWhiteSpace(_newFilterName)">
                        Save Filter
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@* ===== Existing Filters List ===== *@
@if (_filters is null)
{
    <p>Loading...</p>
}
else if (_filters.Count == 0)
{
    <div class="alert alert-info">
        You haven't saved any filters yet. Click "New Filter" above to create one.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var filter in _filters)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            @if (_editingId == filter.Id)
                            {
                                <input type="text" class="form-control form-control-sm w-50" @bind="_editName" />
                            }
                            else
                            {
                                <h5 class="card-title mb-1">@filter.Name</h5>
                            }
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       checked="@filter.IsActive"
                                       @onchange="() => ToggleActive(filter)" />
                                <label class="form-check-label small">@(filter.IsActive ? "Active" : "Paused")</label>
                            </div>
                        </div>

                        <small class="text-muted d-block mb-3">
                            Created @filter.CreatedAt.ToString("d")
                            @if (filter.LastCheckedAt.HasValue)
                            {
                                <span> | Last checked @filter.LastCheckedAt.Value.ToString("g")</span>
                            }
                        </small>

                        @* Telegram connection *@
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(filter.TelegramChatId))
                            {
                                <span class="badge bg-success me-2">Telegram Connected</span>
                                <button class="btn btn-outline-info btn-sm"
                                        @onclick="() => TestTelegram(filter)">
                                    Test
                                </button>
                                <button class="btn btn-outline-warning btn-sm"
                                        @onclick="() => DisconnectTelegram(filter)">
                                    Disconnect
                                </button>
                            }
                            else if (!string.IsNullOrEmpty(filter.TelegramLinkCode))
                            {
                                <div class="alert alert-warning py-2 mb-0">
                                    <small>
                                        <strong>Waiting for connection...</strong><br/>
                                        1. Add <a href="https://t.me/homeradarsbot" target="_blank">@@homeradarsbot</a> to a Telegram group (or open DM)<br/>
                                        2. Send: <code>/connect @filter.TelegramLinkCode</code>
                                    </small>
                                    <div class="mt-2">
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => CancelLink(filter)">Cancel</button>
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => RefreshFilter(filter)">Refresh</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="() => GenerateLinkCode(filter)">
                                    Connect Telegram
                                </button>
                            }
                        </div>
                    </div>
                    @if (_editCriteriaId == filter.Id)
                    {
                        <div class="card-body border-top">
                            <h6 class="fw-bold mb-3">Edit Filter Criteria</h6>
                            <SearchFilters @ref="_editCriteriaFilters"
                                           InitialRequest="_editCriteriaRequest"
                                           OnSearch="HandleEditCriteriaPreview"
                                           IsLoading="_isEditCriteriaLoading"
                                           ButtonLabel="Preview" />
                            @if (_editCriteriaPreviewCount.HasValue)
                            {
                                <div class="alert alert-info py-2">
                                    This filter matches <strong>@_editCriteriaPreviewCount.Value.ToString("N0")</strong> listings.
                                </div>
                            }
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-success btn-sm" @onclick="() => SaveEditCriteria(filter)"
                                        disabled="@(_editCriteriaNewRequest is null)">
                                    Save Criteria
                                </button>
                                <button class="btn btn-secondary btn-sm" @onclick="CancelEditCriteria">Cancel</button>
                            </div>
                        </div>
                    }
                    <div class="card-footer bg-transparent">
                        @if (_editingId == filter.Id)
                        {
                            <input type="text" class="form-control form-control-sm d-inline-block w-50 me-2" @bind="_editName" />
                            <button class="btn btn-success btn-sm" @onclick="() => SaveEdit(filter)">Save</button>
                            <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(filter)">Edit Name</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartEditCriteria(filter)">
                                @(_editCriteriaId == filter.Id ? "Collapse Criteria" : "Edit Criteria")
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => Delete(filter)">Delete</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<SavedFilter>? _filters;
    private string? _userId;
    private string? _message;
    private bool _messageIsError;

    // New filter
    private bool _showNewFilter;
    private string _newFilterName = string.Empty;
    private SearchFilters? _newSearchFilters;
    private SsGeSearchRequest? _newFilterRequest;
    private int? _previewCount;
    private bool _isPreviewLoading;

    // Edit name
    private int? _editingId;
    private string _editName = string.Empty;

    // Edit criteria
    private int? _editCriteriaId;
    private SsGeSearchRequest? _editCriteriaRequest;
    private SsGeSearchRequest? _editCriteriaNewRequest;
    private SearchFilters? _editCriteriaFilters;
    private int? _editCriteriaPreviewCount;
    private bool _isEditCriteriaLoading;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadFilters();
    }

    private async Task LoadFilters()
    {
        if (_userId is null) return;
        _filters = await Db.SavedFilters
            .Where(f => f.UserId == _userId)
            .OrderByDescending(f => f.CreatedAt)
            .ToListAsync();
    }

    // ===== New Filter =====

    private async Task HandlePreview(SsGeSearchRequest request)
    {
        _newFilterRequest = request;
        _isPreviewLoading = true;
        StateHasChanged();

        try
        {
            var response = await ApiClient.SearchAsync(request);
            // SS.GE totalCount is unreliable (often 0), use actual listing count
            _previewCount = response.TotalCount > 0 ? response.TotalCount : response.Listings.Count;
        }
        catch
        {
            _previewCount = null;
        }
        finally
        {
            _isPreviewLoading = false;
        }
    }

    private async Task SaveNewFilter()
    {
        // Build request from the filter component directly
        var request = _newSearchFilters?.BuildRequest() ?? _newFilterRequest;
        if (string.IsNullOrWhiteSpace(_newFilterName) || request is null || _userId is null) return;
        _newFilterRequest = request;

        try
        {
            var filter = new SavedFilter
            {
                UserId = _userId,
                Name = _newFilterName.Trim(),
                SearchRequestJson = JsonSerializer.Serialize(_newFilterRequest)
            };

            Db.SavedFilters.Add(filter);
            await Db.SaveChangesAsync();

            _newFilterName = string.Empty;
            _newFilterRequest = null;
            _previewCount = null;
            _showNewFilter = false;

            _message = $"Filter \"{filter.Name}\" saved! Connect Telegram to receive notifications.";
            _messageIsError = false;

            await LoadFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save filter");
            _message = "Failed to save filter. Please try again.";
            _messageIsError = true;
        }
    }

    // ===== Telegram Linking =====

    private async Task GenerateLinkCode(SavedFilter filter)
    {
        filter.TelegramLinkCode = GenerateCode();
        await Db.SaveChangesAsync();
    }

    private async Task CancelLink(SavedFilter filter)
    {
        filter.TelegramLinkCode = null;
        await Db.SaveChangesAsync();
    }

    private async Task RefreshFilter(SavedFilter filter)
    {
        // Re-read from DB to check if the bot listener has linked it
        await Db.Entry(filter).ReloadAsync();
    }

    private async Task DisconnectTelegram(SavedFilter filter)
    {
        filter.TelegramChatId = null;
        filter.TelegramLinkCode = null;
        await Db.SaveChangesAsync();
        _message = $"Telegram disconnected from \"{filter.Name}\".";
        _messageIsError = false;
    }

    private async Task TestTelegram(SavedFilter filter)
    {
        if (string.IsNullOrEmpty(filter.TelegramChatId))
        {
            _message = "No Telegram connected for this filter.";
            _messageIsError = true;
            return;
        }

        var success = await TelegramService.SendTestMessageAsync(filter.TelegramChatId);
        _message = success
            ? "Test message sent! Check your Telegram."
            : "Failed to send test message. The bot may have been removed from the chat.";
        _messageIsError = !success;
    }

    // ===== Edit Criteria =====

    private void StartEditCriteria(SavedFilter filter)
    {
        if (_editCriteriaId == filter.Id)
        {
            CancelEditCriteria();
            return;
        }

        _editCriteriaId = filter.Id;
        _editCriteriaRequest = JsonSerializer.Deserialize<SsGeSearchRequest>(filter.SearchRequestJson);
        _editCriteriaNewRequest = null;
        _editCriteriaPreviewCount = null;
    }

    private void CancelEditCriteria()
    {
        _editCriteriaId = null;
        _editCriteriaRequest = null;
        _editCriteriaNewRequest = null;
        _editCriteriaPreviewCount = null;
    }

    private async Task HandleEditCriteriaPreview(SsGeSearchRequest request)
    {
        _editCriteriaNewRequest = request;
        _isEditCriteriaLoading = true;
        StateHasChanged();

        try
        {
            var response = await ApiClient.SearchAsync(request);
            _editCriteriaPreviewCount = response.TotalCount > 0 ? response.TotalCount : response.Listings.Count;
        }
        catch
        {
            _editCriteriaPreviewCount = null;
        }
        finally
        {
            _isEditCriteriaLoading = false;
        }
    }

    private async Task SaveEditCriteria(SavedFilter filter)
    {
        if (_editCriteriaNewRequest is null) return;

        filter.SearchRequestJson = JsonSerializer.Serialize(_editCriteriaNewRequest);
        filter.LastSeenApplicationId = null; // reset baseline so it re-checks
        await Db.SaveChangesAsync();

        CancelEditCriteria();
        _message = $"Filter \"{filter.Name}\" criteria updated.";
        _messageIsError = false;
    }

    // ===== Edit / Delete =====

    private async Task ToggleActive(SavedFilter filter)
    {
        filter.IsActive = !filter.IsActive;
        await Db.SaveChangesAsync();
        _message = $"Filter \"{filter.Name}\" {(filter.IsActive ? "activated" : "paused")}.";
        _messageIsError = false;
    }

    private void StartEdit(SavedFilter filter)
    {
        _editingId = filter.Id;
        _editName = filter.Name;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEdit(SavedFilter filter)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        filter.Name = _editName.Trim();
        await Db.SaveChangesAsync();
        _editingId = null;
        _message = "Filter updated.";
        _messageIsError = false;
    }

    private async Task Delete(SavedFilter filter)
    {
        var name = filter.Name;
        Db.SavedFilters.Remove(filter);
        await Db.SaveChangesAsync();
        _filters?.Remove(filter);
        _message = $"Filter \"{name}\" deleted.";
        _messageIsError = false;
    }

    private static string GenerateCode()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var random = Random.Shared;
        return new string(Enumerable.Range(0, 8).Select(_ => chars[random.Next(chars.Length)]).ToArray());
    }
}
